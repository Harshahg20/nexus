# Example secrets.toml — copy to .streamlit/secrets.toml and fill in your values.
# NEVER commit secrets.toml to Git (it is listed in .gitignore).
#
# Authentication: NEXUS uses Snowflake key-pair authentication.
# Generate your key pair:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt -out rsa_key.pem
#   openssl rsa -in rsa_key.pem -pubout -out rsa_key.pub
# Then register the public key in Snowflake:
#   ALTER USER <your_user> SET RSA_PUBLIC_KEY='<contents of rsa_key.pub without headers>';

[connections.snowflake]
account          = "your-account-identifier"   # e.g. "abc12345.us-east-1"
user             = "your-snowflake-user"
private_key_path = "/absolute/path/to/rsa_key.pem"   # unencrypted PEM file — keep outside repo
role             = "ACCOUNTADMIN"
warehouse        = "COMPUTE_WH"
database         = "NEXUS_DB"
